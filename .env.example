# Local development only. Run npm run setup:env to create an ignored .env.
# Blank values below are intentional; no real credentials belong in this file.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=fashion_dev
DB_USER=app_rw_user
DB_PASSWORD=
DB_POOL_MAX=10
POSTGRES_PASSWORD=
# Only migration tooling uses db_admin. Never expose this URL through VITE_*.
MIGRATION_DATABASE_URL=
# JWT primitives only; login/register and DB actor checks belong to T04.
JWT_SECRET=
JWT_ISSUER=fashion-api
JWT_AUDIENCE=fashion-web
# Public browser configuration. Relative URL uses the Vite proxy in development.
VITE_API_BASE_URL=/api
