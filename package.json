{
  "name": "fashion-ecommerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": "^24.0.0 || ^26.0.0",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "dev": "concurrently --kill-others -n api,web \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "build": "npm run build --workspaces",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/migrate.mjs up",
    "db:migrate:down": "node scripts/migrate.mjs down",
    "db:verify": "node scripts/verify-database.mjs",
    "db:seed": "node scripts/seed-database.mjs",
    "db:test": "node --test database/tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "eslint": "10.15.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.73.0",
    "globals": "17.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "concurrently": "9.2.5",
    "tsx": "4.23.15",
    "vitest": "4.1.12",
    "@types/node": "24.19.2",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "dotenv": "17.4.2"
  },
  "overrides": {
    "vite": "7.3.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
