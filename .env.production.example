# PRODUCTION environment template — NO real values. Copy keys into the hosting provider's
# secret manager (Render/VPS systemd EnvironmentFile/Vercel), never into Git or chat.
# See docs/DEPLOYMENT.md §4.

# ---------- Backend runtime (Render Web Service / VPS) ----------
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Exact https origin of the deployed frontend (single origin; CORS allowlist).
FRONTEND_ORIGIN=https://shop.example.com
# Runtime role ONLY (least privilege). Never use the provider admin/owner user here.
DB_HOST=
DB_PORT=5432
DB_NAME=fashion_prod
DB_USER=app_rw_user
DB_PASSWORD=
DB_POOL_MAX=10
# Production requires verify-full (certificate + hostname verification).
DB_SSL_MODE=verify-full
# Optional PEM CA bundle (single line with \n allowed) when the provider CA is not publicly trusted.
DB_SSL_CA=
# Set after verifying the actual proxy chain; 1 for a single Nginx proxy.
TRUST_PROXY=1
# Defaults to true in production; set false to silence access logs.
LOG_REQUESTS=true
# >=32 random chars, backend + operations monitor only. Header: X-Readiness-Token.
READINESS_TOKEN=
# >= 32 random chars, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ISSUER=fashion-api
JWT_AUDIENCE=fashion-web

# ---------- Migration job ONLY (CI deploy step / operator shell) ----------
# Admin/owner connection that is a member of db_admin. Never given to the runtime service.
# Example: postgresql://<owner>:<password>@<host>:5432/fashion_prod?sslmode=verify-full
MIGRATION_DATABASE_URL=
MIGRATION_SSL_CA=

# ---------- Frontend build (Vercel / Cloudflare Pages) ----------
# Public value baked into the JS bundle. Must be the https API base including /api.
VITE_API_BASE_URL=https://api.example.com/api
